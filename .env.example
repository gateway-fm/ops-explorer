# Block Explorer — port configuration
#
# These variables control the host ports exposed by docker compose.
# Internal container ports are fixed; only the host-side mappings change.
#
# For parallel stacks (worktrees), generate this file automatically:
#   ./scripts/stack-ports.sh auto > .env
#
# Or run `make dev-stack` which does this for you when the directory
# name differs from "block-explorer".

# Host ports
FRONTEND_PORT=3001
API_PORT=8081
POSTGRES_PORT=5433
ANVIL_PORT=8546
PUBLIC_API_PORT=8082

# Open Privacy Suite shared network name (must match the suite's COMPOSE_NETWORK_NAME)
PROXY_NETWORK=privacy-proxy_proxy-network

# Open Privacy Suite connection (container-to-container, not host ports)
# PROXY_HOST=privacy-proxy-backend
# ANVIL_HOST=privacy-proxy-anvil
# HOST_PORT_PROXY=8080

# Indexer tuning
# CATCHUP_WORKERS=10
# RPC_WORKERS=50
# RPC_RATE_LIMIT=500
# LOG_LEVEL=info

# SSO / OAuth
# SSO_CLIENT_ID=explorer
# SSO_REDIRECT_URI=http://localhost:3001/api/auth/callback
