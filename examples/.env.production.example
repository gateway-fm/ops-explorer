# =============================================================================
# Block Explorer — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp examples/.env.production.example .env
#
# Then run:
#   docker compose -f examples/docker-compose.production.yml up -d
# =============================================================================

# --- Required ---
VERSION=0.0.1                                    # Image version tag
RPC_URL=https://rpc.your-chain.example.com       # Chain RPC endpoint
CHAIN_ID=1                                       # Chain ID (decimal)
POSTGRES_PASSWORD=changeme                       # Database password

# --- Network ---
NETWORK_NAME=My Chain                            # Shown in MetaMask
NETWORK_CURRENCY=ETH                             # Native currency symbol

# --- Ports ---
API_PORT=8081
PUBLIC_API_PORT=8082
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# --- Database ---
POSTGRES_USER=explorer
POSTGRES_DB=explorer

# --- Indexer tuning ---
POLL_INTERVAL=2s
START_BLOCK=0
LOG_LEVEL=info
CATCHUP_WORKERS=10
RPC_WORKERS=50
RPC_RATE_LIMIT=500

# --- Public API rate limiting ---
RATE_LIMIT=100
RATE_LIMIT_WINDOW=1m
PUBLIC_API_URL=https://api.your-explorer.example.com

# --- Branding (optional) ---
# BRAND_NAME=My Explorer
# BRAND_COMPANY=My Company
# BRAND_COLOR_PRIMARY=#8950FA
# BRAND_LOGO=/logo.svg
# BRAND_ICON=/mascot.png

# --- Branding links (set empty to hide) ---
# BRAND_WEBSITE=https://example.com
# BRAND_DOCS=https://docs.example.com
# BRAND_LEGAL=https://example.com/legal
# BRAND_SECURITY=
# BRAND_TRUST=
# BRAND_TWITTER=https://x.com/mychain
# BRAND_DISCORD=https://discord.gg/mychain
# BRAND_LINKEDIN=
# BRAND_TELEGRAM=
