FROM golang:1.26.6-alpine AS builder

# Upgrade system packages
RUN apk update --no-cache && apk upgrade --no-cache

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build identity stamped into the binary via -ldflags (mirrors privacy-proxy
# RD-1023). CI forwards these as --build-arg; a plain `docker build` falls back
# to the safe defaults so it never fails when git metadata is unavailable.
ARG VERSION=dev
ARG GIT_COMMIT=none
ARG BUILD_TIME=unknown
ENV VERSION_LDFLAGS="-X explorer/internal/version.Version=${VERSION} -X explorer/internal/version.Commit=${GIT_COMMIT} -X explorer/internal/version.BuildTime=${BUILD_TIME}"

# Standalone build — supports both INDEXER_URL (chain-indexer gRPC)
# and PRIVACY_PROXY_URL (privacy-proxy REST) modes. Published as
# gatewayfm/block-explorer-api by .github/workflows/release.yml's
# release-api job (with `target: standalone` set explicitly).
FROM builder AS builder-standalone
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "${VERSION_LDFLAGS}" -o /api ./cmd/api

# Privacy build — compiles out internal/api/indexerclient via the
# "privacy" build tag so the binary cannot speak chain-indexer gRPC at
# all. See cmd/api/provider_privacy.go. Use for privacy-mode
# deployments where direct chain-indexer access would bypass
# privacy-proxy's redaction layer. Published as
# gatewayfm/block-explorer-api-privacy by the release-api-privacy job
# (with `target: privacy` set explicitly).
FROM builder AS builder-privacy
RUN CGO_ENABLED=0 GOOS=linux go build -tags privacy -ldflags "${VERSION_LDFLAGS}" -o /api ./cmd/api

# Both runtime stages below are explicitly selected by their respective
# release jobs via `target:`. Stage ORDER does not determine which one
# is "default" — the release workflow names each one. RD-922.

# Standalone runtime image (published as gatewayfm/block-explorer-api).
FROM gcr.io/distroless/static-debian13:nonroot@sha256:963fa6c544fe5ce420f1f54fb88b6fb01479f054c8056d0f74cc2c6000df5240 AS standalone

COPY --from=builder-standalone /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder-standalone /api /api

USER nonroot:nonroot

ENTRYPOINT ["/api"]

# Privacy runtime image (published as gatewayfm/block-explorer-api-privacy).
# indexerclient package excluded at compile time.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:963fa6c544fe5ce420f1f54fb88b6fb01479f054c8056d0f74cc2c6000df5240 AS privacy

COPY --from=builder-privacy /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder-privacy /api /api

USER nonroot:nonroot

ENTRYPOINT ["/api"]
